{
  "name": "nightwire",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "cd backend && npm ci --omit=dev && cd ../frontend && npm ci --include=dev && npm run build",
    "start": "cd backend && npm start",
    "seed": "cd backend && npm run seed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test -- --verbose",
    "test:frontend": "cd frontend && npm test -- --reporter=verbose",
    "test:e2e": "npm run build --prefix frontend -- --mode e2e && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.4.0",
    "prettier": "^3.10.1"
  }
}
