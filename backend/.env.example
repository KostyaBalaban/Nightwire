# ── Required ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nightwire?retryWrites=true&w=majority
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=change_me_to_a_long_random_string

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Origin of the frontend (CORS + Socket.io). In production: the public URL of the app.
CLIENT_URL=http://localhost:5173

# ── Cloudinary (avatars, images and files in messages) ──────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Resend (optional: without a key, emails are skipped) ────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=NightWire

# ── Arcjet rate limiting (optional: without a key, rate limiting is off) ────
ARCJET_KEY=ajkey_your_arcjet_key
# Only for local development; do not set in production
ARCJET_ENV=development

# ── Demo data (optional, used by `npm run seed`) ─────────────────────────────
# DEMO_PASSWORD=nightwire-demo
